# Compass — copie para .env e preencha.
# Produção: as mesmas chaves vivem em `vercel env add <NOME> production`.

# --- Obrigatórias ---------------------------------------------------------
# Sem DATABASE_URL toda página que toca o banco responde 500 (ex.: /pricing).
DATABASE_URL="postgresql://user:pass@host:5432/compass?sslmode=require"
# URL pública. Entra nos links de e-mail e no retorno do Stripe — se ficar
# errada, o usuário volta do checkout no domínio errado.
APP_URL="https://compass.polarisia.com.br"
# Segredo do NextAuth: openssl rand -base64 32
AUTH_SECRET=""

# --- Login (sem isso, ninguém entra) --------------------------------------
# GitHub › Settings › Developer settings › OAuth Apps
# Callback: $APP_URL/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Resend: magic link + e-mails de alerta (src/lib/email.ts)
AUTH_RESEND_KEY=""
# Opcional — default "Compass <auth@polarisia.com.br>".
# O domínio do remetente precisa estar VERIFICADO no Resend, senão o e-mail
# some sem erro visível.
EMAIL_FROM=""
# Opcional — dias de trial, default 7 (src/lib/auth.ts)
TRIAL_DAYS="7"

# --- Cobrança -------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_LIFETIME="price_..."
# Endpoint POST $APP_URL/api/stripe/webhook. Webhook morto = cliente paga e
# não vira assinante.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Opcional — contador de urgência do /pricing, default 50
LIFETIME_SLOTS="50"

# --- Operação -------------------------------------------------------------
# Bearer token do GET /api/cron/alerts. A Vercel injeta sozinha no cron
# declarado em vercel.json quando a var existe no projeto.
CRON_SECRET=""
# E-mail que libera o /admin
ADMIN_EMAIL=""
# Só o /api/admin/assist usa
ANTHROPIC_API_KEY=""
